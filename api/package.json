{
  "name": "@testimony/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/local/server.ts",
    "serve:seed": "tsx src/local/server.ts",
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --exclude \"**/*.integration.test.ts\"",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@azure/functions": "^4.17.0",
    "@testimony/shared": "*",
    "mssql": "^12.7.14"
  },
  "devDependencies": {
    "@testimony/db": "*",
    "@types/mssql": "^12.3.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  }
}
